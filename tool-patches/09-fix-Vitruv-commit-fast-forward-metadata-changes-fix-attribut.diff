+  /**
+   * Stages and commits {@code .vitruvius/vsum/<targetBranch>/}, whose content
+   * {@link PostMergeHandler#copyVsumFromSourceBranch} (or a caller-supplied equivalent) just
+   * wrote into the working tree after a fast-forward.
+   *
+   * <p>That copy is a plain filesystem write, not a Git operation: left uncommitted, it is
+   * indistinguishable from the "VSUM-internal writes that accumulate in the working tree after
+   * each commit" that {@link BranchManager#switchBranch} intentionally wipes with a hard-reset
+   * before its next checkout. Without committing here, the very next branch switch would
+   * silently revert the target branch's metadata to whatever its own last commit had -- which,
+   * for a branch like {@code main} that mostly receives fast-forwards rather than being
+   * actively committed to, can be far out of date (e.g. its state from before any of the
+   * fast-forwarded branch's changes existed) even though the working tree looked correct
+   * immediately after this merge.
+   *
+   * <p>Non-fatal if the directory does not exist or the commit fails: worst case, the copy is
+   * lost to the next switch exactly as it would have been without this method, which matches
+   * this merge's pre-fix behaviour rather than regressing it.
+   *
+   * @param git          the open Git instance for the current repository.
+   * @param targetBranch the branch whose VSUM metadata directory was just overwritten.
+   */
+  private void commitVsumMetadataCopy(Git git, String targetBranch) {
+    Path vsumDir = repoRoot.resolve(".vitruvius/vsum").resolve(targetBranch);
+    if (!Files.isDirectory(vsumDir)) {
+      return;
+    }
+    try {
+      String relativePath = repoRoot.relativize(vsumDir).toString().replace('\\', '/');
+      git.add().addFilepattern(relativePath).call();
+      // Nothing to commit if the copied content is byte-identical to what was already tracked
+      // (e.g. a fast-forward onto a branch whose own VSUM metadata never diverged from
+      // targetBranch's). git commit would otherwise fail with "nothing to commit".
+      if (git.status().call().isClean()) {
+        return;
+      }
+      git.commit()
+          .setMessage("[vitruvius] Sync VSUM metadata for '" + targetBranch + "' after fast-forward"
+              + "\n\nVitruvius-System: true")
+          .setNoVerify(true)
+          .call();
+      LOGGER.info("Committed VSUM metadata sync for branch '{}'", targetBranch);
+    } catch (org.eclipse.jgit.api.errors.GitAPIException e) {
+      LOGGER.warn("Failed to commit VSUM metadata sync for '{}' (non-critical): {}",
+          targetBranch, e.getMessage());
+    }
+  }
