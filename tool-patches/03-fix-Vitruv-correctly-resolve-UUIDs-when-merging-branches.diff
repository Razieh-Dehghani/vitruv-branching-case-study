+  private void copyMergedVsumMetadata(Path mergedFolder, Path repoRoot) throws IOException {
+    Path sourceVsumMeta = mergedFolder.resolve(".vitruvius");
+    if (!Files.isDirectory(sourceVsumMeta)) {
+        LOGGER.warn("No .vitruvius metadata found in merged state folder {}", mergedFolder);
+        return;
+    }
+    Path targetVsumMeta = repoRoot.resolve(".vitruvius");
+
+    String tempAbsolutePath = mergedFolder.toAbsolutePath().toString();
+    String repoAbsolutePath = repoRoot.toAbsolutePath().toString();
+    String tempUriPrefix = org.eclipse.emf.common.util.URI.createFileURI(tempAbsolutePath).toString();
+    String repoUriPrefix = org.eclipse.emf.common.util.URI.createFileURI(repoAbsolutePath).toString();
+
+    try (var stream = Files.walk(sourceVsumMeta)) {
+        List<Path> files = stream.filter(Files::isRegularFile).toList();
+        for (Path p : files) {
+            Path relative = sourceVsumMeta.relativize(p);
+            Path target = targetVsumMeta.resolve(relative);
+            Files.createDirectories(target.getParent());
+
+            // VSUM metadata files (models list, UUID mapping, correspondences) are plain text with embedded 'file://'' URIs. Rewrite the
+            // tempDir prefix to the real repo path so the paths resolve correctly after copying
+            String content = Files.readString(p, java.nio.charset.StandardCharsets.UTF_8);
+            String rewritten = content.replace(tempUriPrefix, repoUriPrefix).replace(tempAbsolutePath, repoAbsolutePath);
+
+            Files.writeString(target, rewritten, java.nio.charset.StandardCharsets.UTF_8);
+        }
+    }
+    LOGGER.info("Copied and rewrote merged VSUM metadata from {} to {}", sourceVsumMeta, targetVsumMeta);
+  }
